{
	"info": {
		"_postman_id": "dogfood-hackathon-platform",
		"name": "Dogfood Hackathon Platform",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Auth",
			"item": [
				{
					"name": "Register User",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"testuser@example.com\",\n    \"password\": \"TestPass123!\",\n    \"displayName\": \"Test User\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/auth/register",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"auth",
								"register"
							]
						}
					}
				},
				{
					"name": "Verify Email",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"token\": \"replace_with_token_from_logs_or_db\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/auth/verify-email",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"auth",
								"verify-email"
							]
						}
					}
				},
				{
					"name": "WebAuthn Register Begin",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"testuser@example.com\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/auth/webauthn/register/begin",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"auth",
								"webauthn",
								"register",
								"begin"
							]
						}
					}
				},
				{
					"name": "WebAuthn Register Finish",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "X-WebAuthn-Session",
								"value": "replace_with_session_id"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"id\": \"credential_id\",\n    \"rawId\": \"raw_credential_id\",\n    \"response\": {\n        \"clientDataJSON\": \"...\",\n        \"attestationObject\": \"...\"\n    },\n    \"type\": \"public-key\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/auth/webauthn/register/finish?email=testuser@example.com",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"auth",
								"webauthn",
								"register",
								"finish"
							],
							"query": [
								{
									"key": "email",
									"value": "testuser@example.com"
								}
							]
						}
					}
				},
				{
					"name": "WebAuthn Login Begin",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"testuser@example.com\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/auth/webauthn/login/begin",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"auth",
								"webauthn",
								"login",
								"begin"
							]
						}
					}
				}
			]
		}
	],
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:8080"
		}
	]
}
